# Vite dev proxy target (Node.js only — never bundled into the browser).
# Default when unset: http://server:8080 (Docker DNS, works inside docker compose).
API_PROXY_TARGET=http://server.vs.orb.local:8080

# API path prefix used by the browser. Default "/management-api" routes through
# the Vite proxy above. Override to a full URL to bypass the proxy (needs CORS).
VITE_API_BASE_PATH=/management-api
